{
  "name": "agentlogin-reference",
  "private": true,
  "version": "0.1.0",
  "description": "Reference implementation of the Agent Login specification",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/issuer packages/conformance packages/agentlogin packages/rp",
    "typecheck": "npm run build",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 packages/issuer/test/*.test.ts packages/agentlogin/test/*.test.ts packages/rp/test/*.test.ts packages/conformance/test/*.test.ts",
    "issuer": "node --import tsx packages/issuer/src/server.ts",
    "conformance": "node packages/conformance/bin/agentlogin-conformance.js",
    "agentlogin": "node packages/agentlogin/bin/agentlogin.js",
    "example": "node --import tsx examples/rp-hono/server.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.0",
    "@types/node": "^22.18.0",
    "hono": "^4.9.0",
    "openid-client": "^6.8.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
